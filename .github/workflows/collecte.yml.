name: Collecte quotidienne
on:
  schedule: [{cron: "0 7 * * *"}]
  workflow_dispatch:
permissions:
  contents: write
jobs:
  collecte:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.12"}
      - run: pip install -r requirements.txt
      - run: python collecteur.py
      - run: |
          git config user.name "collecteur"
          git config user.email "collecteur@users.noreply.github.com"
          git add data
          git diff --cached --quiet || git commit -m "Mise à jour des appels d'offres"
          git push
